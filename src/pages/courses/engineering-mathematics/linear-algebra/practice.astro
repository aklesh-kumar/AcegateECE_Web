---
import Layout from "../../../../layouts/Layout.astro";
---

<Layout
  title="Linear Algebra Practice | Engineering Mathematics | ACEgate ECE"
  description="Practice Linear Algebra questions for GATE ECE preparation with ACEgate ECE."
>
  <main class="practice-page">

    <section class="practice-hero">
      <div class="container">

        <a
          href="/courses/engineering-mathematics/linear-algebra"
          class="back-link"
        >
          ← Back to Linear Algebra
        </a>

        <p class="eyebrow">
          ENGINEERING MATHEMATICS
        </p>

        <h1>
          Linear Algebra Practice
        </h1>

        <p class="hero-description">
          Strengthen your Linear Algebra concepts with
          topic-wise practice questions designed for GATE ECE.
        </p>

      </div>
    </section>


    <section class="content-section">
      <div class="container">

        <div class="section-heading">
          <p class="section-label">
            PRACTICE
          </p>

          <h2>
            Practice by Topic
          </h2>

          <p>
            Choose a topic to practice important Linear Algebra
            concepts and exam-oriented questions.
          </p>
        </div>


        <div class="practice-grid">

          <article class="practice-card">
            <div class="practice-number">
              01
            </div>

            <h3>
              Matrices
            </h3>

            <p>
              Practice matrix operations, properties and
              important concepts.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>


          <article class="practice-card">
            <div class="practice-number">
              02
            </div>

            <h3>
              Determinants
            </h3>

            <p>
              Practice determinant properties and
              calculation-based questions.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>


          <article class="practice-card">
            <div class="practice-number">
              03
            </div>

            <h3>
              Rank of Matrix
            </h3>

            <p>
              Strengthen your understanding of rank and
              matrix reduction techniques.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>


          <article class="practice-card">
            <div class="practice-number">
              04
            </div>

            <h3>
              System of Linear Equations
            </h3>

            <p>
              Practice questions involving consistency
              and solutions of linear systems.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>


          <article class="practice-card">
            <div class="practice-number">
              05
            </div>

            <h3>
              Eigenvalues and Eigenvectors
            </h3>

            <p>
              Practice important eigenvalue and
              eigenvector problems.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>


          <article class="practice-card">
            <div class="practice-number">
              06
            </div>

            <h3>
              Diagonalization
            </h3>

            <p>
              Practice matrix diagonalization and
              related concepts.
            </p>

            <span>
              Questions Coming Soon →
            </span>
          </article>

        </div>


        <div class="coming-box">

          <strong>
            Practice questions are coming soon.
          </strong>

          <p>
            Topic-wise questions, answers and detailed
            solutions will be added here.
          </p>

        </div>

      </div>
    </section>

  </main>
</Layout>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  .practice-page {
    min-height: 100vh;
    background: #ffffff;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }


  /* HERO */

  .practice-hero {
    padding: 45px 0 90px;

    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(79, 70, 229, 0.13),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #eef2ff 0%,
        #ffffff 72%
      );

    border-bottom: 1px solid #eef0f5;
  }

  .back-link {
    display: inline-block;

    margin-bottom: 55px;

    color: #4f46e5;

    text-decoration: none;

    font-weight: 700;
  }

  .back-link:hover {
    color: #3730a3;
  }

  .eyebrow {
    margin: 0 0 14px;

    color: #4f46e5;

    font-size: 0.82rem;

    font-weight: 800;

    letter-spacing: 0.12em;
  }

  .practice-hero h1 {
    margin: 0;

    color: #111827;

    font-size: clamp(2.8rem, 6vw, 5rem);

    line-height: 1;

    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 760px;

    margin: 28px 0 0;

    color: #4b5563;

    font-size: 1.2rem;

    line-height: 1.75;
  }


  /* CONTENT */

  .content-section {
    padding: 90px 0;
  }

  .section-heading {
    max-width: 760px;

    margin-bottom: 40px;
  }

  .section-label {
    margin: 0 0 8px;

    color: #4f46e5;

    font-size: 0.78rem;

    font-weight: 800;

    letter-spacing: 0.12em;
  }

  .section-heading h2 {
    margin: 0;

    color: #111827;

    font-size: clamp(2rem, 4vw, 3rem);

    line-height: 1.1;

    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child {
    margin: 16px 0 0;

    color: #6b7280;

    line-height: 1.7;
  }


  /* PRACTICE GRID */

  .practice-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
  }

  .practice-card {
    padding: 30px;

    border: 1px solid #e5e7eb;

    border-radius: 20px;

    background: #ffffff;

    box-shadow:
      0 4px 18px rgba(17, 24, 39, 0.04);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .practice-card:hover {
    transform: translateY(-5px);

    border-color: #c7d2fe;

    box-shadow:
      0 16px 30px rgba(17, 24, 39, 0.08);
  }

  .practice-number {
    margin-bottom: 18px;

    color: #4f46e5;

    font-size: 0.85rem;

    font-weight: 800;
  }

  .practice-card h3 {
    margin: 0;

    color: #111827;

    font-size: 1.3rem;
  }

  .practice-card p {
    margin: 12px 0 22px;

    color: #6b7280;

    line-height: 1.6;
  }

  .practice-card span {
    color: #4f46e5;

    font-size: 0.85rem;

    font-weight: 800;
  }


  /* COMING BOX */

  .coming-box {
    margin-top: 35px;

    padding: 25px;

    border: 1px solid #c7d2fe;

    border-radius: 16px;

    background: #eef2ff;
  }

  .coming-box strong {
    color: #3730a3;
  }

  .coming-box p {
    margin: 8px 0 0;

    color: #4b5563;

    line-height: 1.6;
  }


  /* TABLET */

  @media (max-width: 950px) {

    .practice-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  /* MOBILE */

  @media (max-width: 600px) {

    .container {
      width: min(100% - 32px, 1160px);
    }

    .practice-hero {
      padding: 35px 0 65px;
    }

    .back-link {
      margin-bottom: 45px;
    }

    .content-section {
      padding: 65px 0;
    }

    .practice-grid {
      grid-template-columns: 1fr;
    }

    .practice-card {
      padding: 24px;
    }

  }
</style>