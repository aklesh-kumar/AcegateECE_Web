---
import Layout from "../../../../layouts/Layout.astro";
---

<Layout
  title="Linear Algebra Resources | Engineering Mathematics | ACEgate ECE"
  description="Useful resources for Linear Algebra and GATE ECE preparation."
>
  <main class="resources-page">
    <section class="resources-hero">
      <div class="container">
        <a
          href="/courses/engineering-mathematics/linear-algebra"
          class="back-link"
        >
          ← Back to Linear Algebra
        </a>

        <p class="eyebrow">ENGINEERING MATHEMATICS</p>

        <h1>Linear Algebra<br />Resources</h1>

        <p class="hero-description">
          Access useful study resources, reference material and
          preparation support for Linear Algebra.
        </p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">RESOURCES</p>

          <h2>Study Resources</h2>

          <p>
            Carefully organized resources to support your
            Linear Algebra preparation for GATE ECE.
          </p>
        </div>

        <div class="resource-grid">
          <article class="resource-card">
            <div class="resource-icon">📘</div>

            <h3>Reference Notes</h3>

            <p>
              Additional reference material to strengthen
              your understanding of Linear Algebra concepts.
            </p>

            <span>Coming Soon →</span>
          </article>

          <article class="resource-card">
            <div class="resource-icon">📐</div>

            <h3>Formula Sheet</h3>

            <p>
              Important formulas and results for quick
              revision before the examination.
            </p>

            <span>Coming Soon →</span>
          </article>

          <article class="resource-card">
            <div class="resource-icon">📝</div>

            <h3>Revision Material</h3>

            <p>
              Concise revision material covering important
              Linear Algebra concepts.
            </p>

            <span>Coming Soon →</span>
          </article>

          <article class="resource-card">
            <div class="resource-icon">🎯</div>

            <h3>GATE Preparation Tips</h3>

            <p>
              Useful preparation guidance and strategies
              for Linear Algebra.
            </p>

            <span>Coming Soon →</span>
          </article>

          <article class="resource-card">
            <div class="resource-icon">🔗</div>

            <h3>Useful Links</h3>

            <p>
              Important educational links and external
              learning resources.
            </p>

            <span>Coming Soon →</span>
          </article>

          <article class="resource-card">
            <div class="resource-icon">📂</div>

            <h3>Downloadable Material</h3>

            <p>
              Downloadable study material will be organized
              here for easy access.
            </p>

            <span>Coming Soon →</span>
          </article>
        </div>

        <div class="coming-box">
          <strong>More resources are coming soon.</strong>

          <p>
            Formula sheets, revision material, reference
            resources and other useful study materials will
            be added here gradually.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  .resources-page {
    min-height: 100vh;
    background: #ffffff;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  .resources-hero {
    padding: 45px 0 90px;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(79, 70, 229, 0.13),
        transparent 32%
      ),
      linear-gradient(135deg, #eef2ff 0%, #ffffff 72%);
    border-bottom: 1px solid #eef0f5;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 55px;
    color: #4f46e5;
    text-decoration: none;
    font-weight: 700;
  }

  .back-link:hover {
    color: #3730a3;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #4f46e5;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .resources-hero h1 {
    margin: 0;
    color: #111827;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 760px;
    margin: 28px 0 0;
    color: #4b5563;
    font-size: 1.2rem;
    line-height: 1.75;
  }

  .content-section {
    padding: 90px 0;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 40px;
  }

  .section-label {
    margin: 0 0 8px;
    color: #4f46e5;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .section-heading h2 {
    margin: 0;
    color: #111827;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child {
    margin: 16px 0 0;
    color: #6b7280;
    line-height: 1.7;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .resource-card {
    padding: 30px;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 4px 18px rgba(17, 24, 39, 0.04);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .resource-card:hover {
    transform: translateY(-5px);
    border-color: #c7d2fe;
    box-shadow: 0 16px 30px rgba(17, 24, 39, 0.08);
  }

  .resource-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 14px;
    background: #eef2ff;
    font-size: 1.35rem;
  }

  .resource-card h3 {
    margin: 0;
    color: #111827;
    font-size: 1.25rem;
  }

  .resource-card p {
    margin: 12px 0 22px;
    color: #6b7280;
    line-height: 1.6;
  }

  .resource-card span {
    color: #4f46e5;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .coming-box {
    margin-top: 35px;
    padding: 25px;
    border: 1px solid #c7d2fe;
    border-radius: 16px;
    background: #eef2ff;
  }

  .coming-box strong {
    color: #3730a3;
  }

  .coming-box p {
    margin: 8px 0 0;
    color: #4b5563;
    line-height: 1.6;
  }

  @media (max-width: 950px) {
    .resource-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 32px, 1160px);
    }

    .resources-hero {
      padding: 35px 0 65px;
    }

    .back-link {
      margin-bottom: 45px;
    }

    .content-section {
      padding: 65px 0;
    }

    .resource-grid {
      grid-template-columns: 1fr;
    }

    .resource-card {
      padding: 24px;
    }
  }
</style>