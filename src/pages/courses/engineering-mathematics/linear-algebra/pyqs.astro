---
import Layout from "../../../../layouts/Layout.astro";
---

<Layout
  title="Linear Algebra GATE PYQs | Engineering Mathematics | ACEgate ECE"
  description="Practice GATE previous year questions from Linear Algebra for ECE preparation."
>
  <main class="pyq-page">

    <section class="pyq-hero">
      <div class="container">

        <a
          href="/courses/engineering-mathematics/linear-algebra"
          class="back-link"
        >
          ← Back to Linear Algebra
        </a>

        <p class="eyebrow">
          ENGINEERING MATHEMATICS
        </p>

        <h1>
          Linear Algebra GATE PYQs
        </h1>

        <p class="hero-description">
          Practice previous year GATE questions from Linear Algebra
          and strengthen your understanding through exam-oriented
          problem solving.
        </p>

      </div>
    </section>


    <section class="content-section">
      <div class="container">

        <div class="section-heading">
          <p class="section-label">
            GATE PREVIOUS YEAR QUESTIONS
          </p>

          <h2>
            Linear Algebra PYQs
          </h2>

          <p>
            Topic-wise GATE questions will be organized here with
            solutions and explanations.
          </p>
        </div>


        <div class="pyq-grid">

          <article class="pyq-card">
            <div class="pyq-number">
              01
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                MATRICES
              </p>

              <h3>
                Matrix-based GATE Questions
              </h3>

              <p>
                Questions involving matrix operations, properties
                and important concepts.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>


          <article class="pyq-card">
            <div class="pyq-number">
              02
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                DETERMINANTS
              </p>

              <h3>
                Determinant-based GATE Questions
              </h3>

              <p>
                Previous year questions involving determinants
                and their properties.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>


          <article class="pyq-card">
            <div class="pyq-number">
              03
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                RANK
              </p>

              <h3>
                Rank of Matrix Questions
              </h3>

              <p>
                GATE questions based on rank, independence
                and matrix reduction.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>


          <article class="pyq-card">
            <div class="pyq-number">
              04
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                LINEAR EQUATIONS
              </p>

              <h3>
                System of Linear Equations
              </h3>

              <p>
                GATE questions related to consistency,
                solutions and linear systems.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>


          <article class="pyq-card">
            <div class="pyq-number">
              05
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                EIGENVALUES
              </p>

              <h3>
                Eigenvalues and Eigenvectors
              </h3>

              <p>
                Previous year questions involving eigenvalues,
                eigenvectors and their properties.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>


          <article class="pyq-card">
            <div class="pyq-number">
              06
            </div>

            <div class="pyq-content">
              <p class="pyq-topic">
                DIAGONALIZATION
              </p>

              <h3>
                Matrix Diagonalization
              </h3>

              <p>
                GATE-oriented questions involving diagonalization
                and related matrix concepts.
              </p>

              <span class="status">
                Coming Soon
              </span>
            </div>
          </article>

        </div>


        <div class="coming-box">

          <strong>
            Detailed PYQs are coming soon.
          </strong>

          <p>
            Year-wise and topic-wise GATE questions with
            detailed solutions will be added here.
          </p>

        </div>

      </div>
    </section>

  </main>
</Layout>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  .pyq-page {
    min-height: 100vh;
    background: #ffffff;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }


  /* HERO */

  .pyq-hero {
    padding: 45px 0 90px;

    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(79, 70, 229, 0.13),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #eef2ff 0%,
        #ffffff 72%
      );

    border-bottom: 1px solid #eef0f5;
  }

  .back-link {
    display: inline-block;

    margin-bottom: 55px;

    color: #4f46e5;

    text-decoration: none;

    font-weight: 700;
  }

  .back-link:hover {
    color: #3730a3;
  }

  .eyebrow {
    margin: 0 0 14px;

    color: #4f46e5;

    font-size: 0.82rem;

    font-weight: 800;

    letter-spacing: 0.12em;
  }

  .pyq-hero h1 {
    margin: 0;

    color: #111827;

    font-size: clamp(2.8rem, 6vw, 5rem);

    line-height: 1;

    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 760px;

    margin: 28px 0 0;

    color: #4b5563;

    font-size: 1.2rem;

    line-height: 1.75;
  }


  /* CONTENT */

  .content-section {
    padding: 90px 0;
  }

  .section-heading {
    max-width: 760px;

    margin-bottom: 40px;
  }

  .section-label {
    margin: 0 0 8px;

    color: #4f46e5;

    font-size: 0.78rem;

    font-weight: 800;

    letter-spacing: 0.12em;
  }

  .section-heading h2 {
    margin: 0;

    color: #111827;

    font-size: clamp(2rem, 4vw, 3rem);

    line-height: 1.1;

    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child {
    margin: 16px 0 0;

    color: #6b7280;

    line-height: 1.7;
  }


  /* PYQ GRID */

  .pyq-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
  }

  .pyq-card {
    display: grid;

    grid-template-columns: 65px 1fr;

    gap: 20px;

    padding: 28px;

    border: 1px solid #e5e7eb;

    border-radius: 20px;

    background: #ffffff;

    box-shadow:
      0 4px 18px rgba(17, 24, 39, 0.04);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .pyq-card:hover {
    transform: translateY(-4px);

    border-color: #c7d2fe;

    box-shadow:
      0 14px 28px rgba(17, 24, 39, 0.08);
  }

  .pyq-number {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 52px;

    height: 52px;

    border-radius: 14px;

    background: #eef2ff;

    color: #4f46e5;

    font-size: 0.9rem;

    font-weight: 800;
  }

  .pyq-topic {
    margin: 0 0 6px;

    color: #4f46e5;

    font-size: 0.75rem;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .pyq-content h3 {
    margin: 0;

    color: #111827;

    font-size: 1.25rem;
  }

  .pyq-content > p:not(.pyq-topic) {
    margin: 10px 0 16px;

    color: #6b7280;

    line-height: 1.6;
  }

  .status {
    display: inline-block;

    color: #4f46e5;

    font-size: 0.85rem;

    font-weight: 800;
  }


  /* COMING BOX */

  .coming-box {
    margin-top: 35px;

    padding: 25px;

    border: 1px solid #c7d2fe;

    border-radius: 16px;

    background: #eef2ff;
  }

  .coming-box strong {
    color: #3730a3;
  }

  .coming-box p {
    margin: 8px 0 0;

    color: #4b5563;

    line-height: 1.6;
  }


  /* TABLET */

  @media (max-width: 850px) {

    .pyq-grid {
      grid-template-columns: 1fr;
    }

  }


  /* MOBILE */

  @media (max-width: 600px) {

    .container {
      width: min(100% - 32px, 1160px);
    }

    .pyq-hero {
      padding: 35px 0 65px;
    }

    .back-link {
      margin-bottom: 45px;
    }

    .content-section {
      padding: 65px 0;
    }

    .pyq-card {
      grid-template-columns: 1fr;

      gap: 15px;

      padding: 24px;
    }

  }
</style>