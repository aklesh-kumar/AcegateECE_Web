---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <p class="eyebrow">ACEgate ECE</p>

        <h1>
          Master ECE.<br />
          Crack GATE.<br />
          Build Your Future.
        </h1>

        <p class="hero-text">
          Learn Electronics and Communication Engineering with structured
          courses, notes, previous year questions, practice and more.
        </p>

        <div class="hero-buttons">
          <a href="/courses" class="button primary">
            Explore Courses
          </a>

          <a href="/pyqs" class="button secondary">
            Practice PYQs
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="container">
        <h2>Everything you need for GATE ECE</h2>

        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-icon">📚</div>
            <h3>Courses</h3>
            <p>
              Structured learning for core ECE subjects.
            </p>
            <a href="/courses">Explore Courses →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Notes</h3>
            <p>
              Concept notes, formulas and quick revision material.
            </p>
            <a href="/notes">View Notes →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">🎯</div>
            <h3>PYQs</h3>
            <p>
              Practice previous year GATE questions topic by topic.
            </p>
            <a href="/pyqs">Practice PYQs →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Practice</h3>
            <p>
              Build confidence with focused practice and quizzes.
            </p>
            <a href="/practice">Start Practice →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">📖</div>
            <h3>Resources</h3>
            <p>
              Useful study resources for GATE ECE preparation.
            </p>
            <a href="/resources">Explore Resources →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">🎥</div>
            <h3>Video Lectures</h3>
            <p>
              Learn ECE concepts through structured video lectures.
            </p>
            <a href="/video">Watch Videos →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">✍️</div>
            <h3>Blog</h3>
            <p>
              Study strategies, exam updates and useful ECE insights.
            </p>
            <a href="/blog">Read Blog →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon">🚀</div>
            <h3>Build Your Future</h3>
            <p>
              A growing learning platform designed for ECE aspirants.
            </p>
            <a href="/about">Learn More →</a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #111827;
    background: #ffffff;
  }

  .container {
    width: min(1120px, 92%);
    margin: 0 auto;
  }

  /* Hero */

  .hero {
    padding: 110px 0;
    background: linear-gradient(
      135deg,
      #eef2ff 0%,
      #f8fafc 50%,
      #ffffff 100%
    );
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #4f46e5;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: #111827;
  }

  .hero-text {
    max-width: 700px;
    margin: 30px 0;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 14px 24px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .primary {
    color: #ffffff;
    background: #4f46e5;
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.2);
  }

  .primary:hover {
    background: #4338ca;
  }

  .secondary {
    color: #4f46e5;
    background: #ffffff;
    border: 1px solid #c7d2fe;
  }

  .secondary:hover {
    background: #eef2ff;
  }

  /* Features */

  .features {
    padding: 85px 0;
    background: #ffffff;
  }

  .features h2 {
    margin: 0;
    font-size: 2.1rem;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .feature-card {
    padding: 26px;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #ffffff;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: #c7d2fe;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  }

  .feature-icon {
    margin-bottom: 14px;
    font-size: 1.7rem;
  }

  .feature-card h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    color: #111827;
  }

  .feature-card p {
    min-height: 72px;
    margin: 0 0 18px;
    color: #6b7280;
    line-height: 1.6;
  }

  .feature-card a {
    color: #4f46e5;
    text-decoration: none;
    font-weight: 700;
  }

  .feature-card a:hover {
    text-decoration: underline;
  }

  /* Tablet */

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile */

  @media (max-width: 600px) {
    .hero {
      padding: 75px 0;
    }

    h1 {
      font-size: clamp(2.7rem, 13vw, 4rem);
    }

    .hero-text {
      font-size: 1.05rem;
    }

    .features {
      padding: 60px 0;
    }

    .features h2 {
      font-size: 1.8rem;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card p {
      min-height: auto;
    }
  }
</style>