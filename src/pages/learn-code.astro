
---
import Layout from "../layouts/Layout.astro";

const languages = [
  {
    number: "01",
    name: "C Programming",
    slug: "c-programming",
    icon: "🔵",
    description: "Master programming fundamentals, memory concepts, pointers and system-level programming.",
    topics: ["Syntax & Variables", "Loops & Functions", "Arrays & Pointers", "Structures & Files"],
    level: "Beginner to Advanced",
    category: "Programming Language",
  },
  {
    number: "02",
    name: "Verilog HDL",
    slug: "verilog",
    icon: "⚡",
    description: "Learn hardware description, RTL design, digital circuits, simulation and FPGA development.",
    topics: ["Logic Gates", "Combinational Logic", "Sequential Logic", "FSM & Testbenches"],
    level: "Beginner to Advanced",
    category: "Hardware Description",
  },
  {
    number: "03",
    name: "Python Programming",
    slug: "python",
    icon: "🐍",
    description: "Learn Python programming, automation, scientific computing and engineering applications.",
    topics: ["Variables & Data Types", "Loops & Functions", "OOP", "NumPy & Matplotlib"],
    level: "Beginner to Advanced",
    category: "Programming Language",
  },
  {
    number: "04",
    name: "C++ Programming",
    slug: "cpp",
    icon: "💻",
    description: "Build strong C++ skills through object-oriented programming and modern software concepts.",
    topics: ["C++ Fundamentals", "OOP", "STL", "Templates & Memory"],
    level: "Beginner to Advanced",
    category: "Programming Language",
  },
  {
    number: "05",
    name: "VHDL",
    slug: "vhdl",
    icon: "🔧",
    description: "Understand VHDL and develop digital hardware designs using simulation and FPGA workflows.",
    topics: ["Entity & Architecture", "Data Types", "Processes", "FSM & Testbenches"],
    level: "Beginner to Advanced",
    category: "Hardware Description",
  },
  {
    number: "06",
    name: "Embedded C",
    slug: "embedded-c",
    icon: "🔌",
    description: "Connect software with hardware through microcontrollers, peripherals and firmware.",
    topics: ["GPIO", "Timers & Interrupts", "UART / SPI / I2C", "Firmware Development"],
    level: "Beginner to Advanced",
    category: "Embedded Programming",
  },
];
---

<Layout>
  <main class="academy">
    <section class="hero">
      <div class="hero-inner">
        <span class="eyebrow">ACEgate ECE • LEARN & CODE ACADEMY</span>
        <h1>Learn. Code. Create.</h1>
        <p class="hero-description">
          Start from absolute basics and progress towards advanced
          programming and hardware design. Learn concepts through
          explanations, examples, exercises and practical projects.
        </p>

        <div class="hero-actions">
          <a href="#learning-tracks" class="primary-button">Explore Learning Tracks ↓</a>
          <a href="#learning-method" class="secondary-button">How It Works</a>
        </div>

        <div class="hero-stats">
          <div><strong>06</strong><span>Learning Tracks</span></div>
          <div><strong>03</strong><span>Learning Levels</span></div>
          <div><strong>100%</strong><span>Free Learning Goal</span></div>
        </div>
      </div>
    </section>

    <section class="welcome">
      <span class="section-label">YOUR LEARNING JOURNEY STARTS HERE</span>
      <h2>From Fundamentals to Advanced Engineering</h2>
      <p>
        Whether you are a beginner learning your first programming
        language or an engineering student developing advanced digital
        systems, ACEgate ECE provides a structured learning path.
      </p>
    </section>

    <section id="learning-tracks" class="tracks">
      <div class="section-heading">
        <div>
          <span class="section-label">CHOOSE YOUR TECHNOLOGY</span>
          <h2>Explore Learning Tracks</h2>
          <p>Choose a language and start learning step by step.</p>
        </div>
        <span class="track-count">06 TRACKS</span>
      </div>

      <div class="track-grid">
        {languages.map((language) => (
          <article class="track-card">
            <div class="track-top">
              <span class="track-number">{language.number}</span>
              <span class="track-icon">{language.icon}</span>
            </div>

            <span class="track-category">{language.category}</span>
            <h3>{language.name}</h3>
            <p class="track-description">{language.description}</p>

            <div class="topic-list">
              {language.topics.map((topic) => (
                <span>{topic}</span>
              ))}
            </div>

            <div class="track-footer">
              <span>{language.level}</span>
              <a href={`/learn-code/${language.slug}/`}>
                Start Learning →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="learning-method" class="learning-method">
      <div class="method-heading">
        <span class="section-label">STRUCTURED LEARNING</span>
        <h2>Three Levels of Learning</h2>
        <p>Build your knowledge progressively without skipping the fundamentals.</p>
      </div>

      <div class="level-grid">
        <article class="level-card">
          <span class="level-number">LEVEL 01</span>
          <h3>Beginner</h3>
          <p>Understand the language and learn to write your first programs.</p>
          <ul>
            <li>Introduction and installation</li>
            <li>Syntax and data types</li>
            <li>Operators and expressions</li>
            <li>Conditions and loops</li>
            <li>Basic coding examples</li>
          </ul>
        </article>

        <article class="level-card featured">
          <span class="level-number">LEVEL 02</span>
          <h3>Intermediate</h3>
          <p>Develop problem-solving skills and understand important concepts.</p>
          <ul>
            <li>Functions and modular design</li>
            <li>Arrays and data structures</li>
            <li>Language-specific concepts</li>
            <li>Debugging and testing</li>
            <li>Practical programming tasks</li>
          </ul>
        </article>

        <article class="level-card">
          <span class="level-number">LEVEL 03</span>
          <h3>Advanced</h3>
          <p>Apply your knowledge to complex engineering and software projects.</p>
          <ul>
            <li>Advanced language concepts</li>
            <li>Performance and optimization</li>
            <li>Real-world applications</li>
            <li>Advanced problem solving</li>
            <li>Major practical projects</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="lesson-features">
      <span class="section-label">EVERY LESSON MATTERS</span>
      <h2>What Will You Get?</h2>

      <div class="feature-grid">
        <div><span>📘</span><h3>Detailed Theory</h3><p>Clear explanations of concepts from fundamentals onwards.</p></div>
        <div><span>⌨️</span><h3>Code Examples</h3><p>Practical source code with understandable explanations.</p></div>
        <div><span>📊</span><h3>Expected Output</h3><p>Understand program behaviour through sample results.</p></div>
        <div><span>📝</span><h3>Practice Exercises</h3><p>Test your understanding with structured questions.</p></div>
        <div><span>🛠️</span><h3>Mini Projects</h3><p>Apply concepts through practical implementation.</p></div>
        <div><span>📂</span><h3>Learning Resources</h3><p>Notes, documentation and useful references.</p></div>
      </div>
    </section>

    <section class="closing">
      <span class="section-label">ACEgate ECE</span>
      <h2>Your Engineering Journey Starts with One Line of Code.</h2>
      <p>
        Learn consistently, practise regularly and turn your knowledge
        into practical engineering skills.
      </p>
      <a href="/projects/" class="closing-button">Explore Engineering Projects →</a>
    </section>
  </main>
</Layout>

<style>
  .academy {
    max-width: 1160px;
    margin: auto;
    padding: 25px 22px 70px;
    color: #172033;
  }

  .hero {
    padding: 75px 30px 45px;
    border-radius: 23px;
    background: linear-gradient(130deg, #101b42, #1e4d91);
    color: white;
    text-align: center;
  }

  .hero-inner { max-width: 820px; margin: auto; }

  .eyebrow, .section-label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #2563eb;
  }

  .eyebrow { color: #bfdbfe; }

  .hero h1 {
    font-size: clamp(38px, 6vw, 64px);
    margin: 23px 0 15px;
    line-height: 1.1;
  }

  .hero-description {
    max-width: 720px;
    margin: auto;
    color: #dbeafe;
    font-size: 16px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .primary-button, .secondary-button, .closing-button {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
  }

  .primary-button { background: white; color: #17366d; }
  .secondary-button { border: 1px solid #93c5fd; color: white; }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 45px;
    margin-top: 50px;
    padding-top: 27px;
    border-top: 1px solid #ffffff30;
  }

  .hero-stats div { display: flex; flex-direction: column; gap: 5px; }
  .hero-stats strong { font-size: 25px; }
  .hero-stats span { font-size: 12px; color: #dbeafe; }

  .welcome {
    max-width: 790px;
    margin: 75px auto;
    text-align: center;
  }

  .welcome h2, .section-heading h2,
  .method-heading h2, .lesson-features h2 {
    font-size: clamp(26px, 4vw, 35px);
    margin: 13px 0;
  }

  .welcome p, .method-heading p {
    color: #64748b;
    line-height: 1.9;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 27px;
  }

  .section-heading p { color: #64748b; font-size: 14px; }

  .track-count {
    padding: 9px 13px;
    background: #eff6ff;
    color: #1d4ed8;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .track-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .track-card {
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: white;
    display: flex;
    flex-direction: column;
    min-height: 350px;
    transition: transform .2s, box-shadow .2s;
  }

  .track-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px #17203312;
  }

  .track-top { display: flex; justify-content: space-between; align-items: center; }
  .track-number { color: #94a3b8; font-size: 13px; font-weight: 900; }
  .track-icon { font-size: 32px; }

  .track-category {
    margin-top: 20px;
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .track-card h3 { font-size: 20px; margin: 8px 0; }

  .track-description {
    color: #64748b;
    font-size: 14px;
    line-height: 1.75;
  }

  .topic-list { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0 20px; }

  .topic-list span {
    padding: 6px 9px;
    border-radius: 6px;
    background: #f1f5f9;
    color: #475569;
    font-size: 11px;
  }

  .track-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .track-footer span { color: #64748b; font-size: 12px; }
  .track-footer a { color: #1d4ed8; text-decoration: none; font-size: 14px; font-weight: 800; }

  .learning-method { margin-top: 85px; }
  .method-heading { text-align: center; margin-bottom: 30px; }

  .level-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .level-card {
    padding: 26px;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
  }

  .level-card.featured { background: #eff6ff; border-color: #bfdbfe; }
  .level-number { color: #2563eb; font-size: 12px; font-weight: 900; }
  .level-card h3 { font-size: 23px; margin: 12px 0; }
  .level-card p, .level-card li { color: #64748b; font-size: 13px; line-height: 1.8; }
  .level-card ul { padding-left: 19px; margin-top: 18px; }

  .lesson-features { margin-top: 85px; text-align: center; }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 17px;
    margin-top: 30px;
    text-align: left;
  }

  .feature-grid > div { padding: 23px; background: #f8fafc; border-radius: 12px; }
  .feature-grid span { font-size: 25px; }
  .feature-grid h3 { font-size: 16px; margin: 12px 0 7px; }
  .feature-grid p { color: #64748b; font-size: 13px; line-height: 1.7; }

  .closing {
    margin-top: 80px;
    padding: 48px 25px;
    background: #eff6ff;
    border-radius: 18px;
    text-align: center;
  }

  .closing h2 { font-size: clamp(25px, 4vw, 34px); }
  .closing p { color: #64748b; line-height: 1.8; }
  .closing-button { margin-top: 17px; background: #1d4ed8; color: white; }

  @media (max-width: 850px) {
    .track-grid, .level-grid, .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 540px) {
    .academy { padding: 16px 13px 45px; }
    .hero { padding: 55px 18px 35px; }
    .track-grid, .level-grid, .feature-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: 22px; }
    .section-heading { align-items: flex-start; flex-direction: column; }
    .welcome { margin: 50px auto; }
  }
</style>
