
---
import Layout from '../layouts/Layout.astro';

const papers = [
  { year: 2026, file: 'EC-2026/EC-2026.pdf' },
  { year: 2025, file: 'EC-2025/EC-2025.pdf' },
  { year: 2024, file: 'EC-2024/EC-2024.pdf' },
  { year: 2023, file: 'EC-2023/GATE-EC-2023.pdf' },
  { year: 2022, file: 'EC-2022/EC-2022.pdf' },
  { year: 2021, file: 'EC-2021/EC-2021.pdf' },
  { year: 2020, file: 'EC-2020/EC-2020.pdf' },
  { year: 2019, file: 'EC-2019/EC-2019.pdf' },
  { year: 2018, file: 'EC-2018/EC-2018.pdf' },
  { year: 2017, file: 'EC-2017/EC-2017.pdf' },
  { year: 2016, file: 'EC-2016/EC-2016.pdf' },
  { year: 2015, file: 'EC-2015/GATE-EC-2015.pdf' },
  { year: 2014, file: 'EC-2014/EC-2014.pdf' },
  { year: 2013, file: 'EC-2013/EC-2013.pdf' },
  { year: 2012, file: 'EC-2012/EC-GATE-2012.pdf' },
  { year: 2011, file: 'EC-2011/EC-GATE-2011.pdf' },
  { year: 2010, file: '2010/EC-2010.pdf' },
  { year: 2009, file: 'EC-2009/EC-2009.pdf' },
  { year: 2008, file: 'EC-2008/EC-2008.pdf' },
  { year: 2007, file: 'EC-2007/EC-2007.pdf' },
  { year: 2006, file: 'EC-2006/EC-2006.pdf' },
  { year: 2005, file: 'EC-2005/EC-2005.pdf' },
  { year: 2004, file: 'EC-2004/EC-2004.pdf' },
  { year: 2003, file: 'EC-2003/EC-2003.pdf' },
  { year: 2002, file: 'EC-2002/EC-2002.pdf' },
  { year: 2001, file: 'EC-2001/EC-2001.pdf' },
  { year: 2000, file: 'EC-2000/EC-2000.pdf' },
];
---

<Layout>
  <main class="pyq-page">
    <section class="hero">
      <span class="eyebrow">ACEgate ECE • FREE LEARNING RESOURCE</span>
      <h1>GATE ECE Previous Year Questions</h1>
      <p>
        Prepare smarter with our year-wise collection of GATE Electronics
        and Communication Engineering question papers.
      </p>

      <div class="stats">
        <div class="stat">
          <strong>27</strong>
          <span>Examination Years</span>
        </div>
        <div class="stat">
          <strong>2000–2026</strong>
          <span>PYQ Collection</span>
        </div>
        <div class="stat">
          <strong>FREE</strong>
          <span>PDF Access</span>
        </div>
      </div>
    </section>

    <section class="library">
      <div class="section-heading">
        <div>
          <span class="eyebrow">QUESTION PAPER LIBRARY</span>
          <h2>Explore Papers by Year</h2>
          <p>Select a year to view or download its GATE ECE paper.</p>
        </div>
        <span class="count">27 PAPERS</span>
      </div>

      <div class="paper-grid">
        {papers.map((paper) => {
          const pdfUrl = `/Pyq-pdfs/${paper.file}`;

          return (
            <article class="paper-card">
              <div class="card-top">
                <span class="pdf-icon">PDF</span>
                <span class="available">Available</span>
              </div>

              <h3>GATE ECE {paper.year}</h3>
              <p>Electronics and Communication Engineering</p>

              <div class="actions">
                <a
                  class="view-btn"
                  href={pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View PDF ↗
                </a>

                <a
                  class="download-btn"
                  href={pdfUrl}
                  download
                >
                  Download ↓
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="notice">
      <h2>Prepare. Practice. Progress.</h2>
      <p>
        Solve previous year question papers regularly, review your mistakes,
        and strengthen your GATE ECE preparation with ACEgate ECE.
      </p>
    </section>
  </main>
</Layout>

<style>
  .pyq-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 45px 24px 70px;
    color: #172033;
  }

  .hero {
    padding: 55px 35px;
    border-radius: 24px;
    background: linear-gradient(135deg, #eef4ff, #f7f8ff);
    text-align: center;
  }

  .eyebrow {
    color: #2458d3;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    margin: 18px 0;
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.15;
    font-weight: 850;
  }

  .hero > p {
    max-width: 680px;
    margin: 0 auto;
    color: #59677e;
    font-size: 17px;
    line-height: 1.8;
  }

  .stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 45px;
    margin-top: 35px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stat strong {
    color: #2458d3;
    font-size: 25px;
  }

  .stat span {
    color: #64748b;
    font-size: 13px;
  }

  .library {
    padding-top: 55px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 8px 0;
    font-size: 30px;
  }

  .section-heading p {
    color: #64748b;
    margin: 0;
  }

  .count {
    padding: 12px 17px;
    border-radius: 30px;
    background: #edf3ff;
    color: #2458d3;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .paper-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .paper-card {
    padding: 23px;
    border: 1px solid #e1e7f0;
    border-radius: 17px;
    background: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .paper-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(30, 55, 100, 0.09);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pdf-icon {
    padding: 8px 11px;
    border-radius: 8px;
    background: #fff0f0;
    color: #d63838;
    font-size: 12px;
    font-weight: 900;
  }

  .available {
    color: #16834c;
    font-size: 12px;
    font-weight: 700;
  }

  .paper-card h3 {
    margin: 22px 0 8px;
    font-size: 22px;
    color: #172033;
  }

  .paper-card > p {
    min-height: 40px;
    margin: 0 0 20px;
    color: #718096;
    font-size: 13px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    gap: 9px;
  }

  .actions a {
    flex: 1;
    padding: 11px 8px;
    border-radius: 9px;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 750;
  }

  .view-btn {
    background: #2458d3;
    color: white;
  }

  .download-btn {
    background: #edf2fa;
    color: #263a59;
  }

  .notice {
    margin-top: 55px;
    padding: 35px;
    border-radius: 18px;
    background: #f3f6fc;
    text-align: center;
  }

  .notice h2 {
    margin: 0 0 10px;
    font-size: 25px;
  }

  .notice p {
    max-width: 700px;
    margin: auto;
    color: #64748b;
    line-height: 1.8;
  }

  @media (max-width: 850px) {
    .paper-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .pyq-page {
      padding: 25px 15px 45px;
    }

    .hero {
      padding: 38px 18px;
    }

    .stats {
      gap: 22px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .paper-grid {
      grid-template-columns: 1fr;
    }

    .paper-card {
      padding: 20px;
    }
  }
</style>
