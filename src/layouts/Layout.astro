---
const title = "ACEgate ECE";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="ACEgate ECE - Learn Electronics and Communication Engineering, prepare for GATE ECE, practice PYQs, access notes and study resources."
    />

    <meta
      name="keywords"
      content="GATE ECE, ECE, Electronics and Communication Engineering, GATE preparation, ECE notes, GATE PYQs"
    />

    
    <meta name="author" content="ACEgate ECE" />

    <meta name="google-site-verification" content="mCr50hyn5i3vVbC0WelySsGw0CJZNyC2EKhb-LR_Ags" />

    <title>{title}</title>


    
  </head>

  <body>
    <header class="site-header">
      <div class="header-container">

        <a href="/" class="logo">ACEgate ECE</a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav
          id="main-navigation"
          class="main-nav"
          aria-label="Main navigation"
        >
          <a href="/">Home</a>
          <a href="/courses">Courses</a>
          <a href="/notes">Notes</a>
          <a href="/pyqs">PYQs</a>
          <a href="/practice">Practice</a>
          <a href="/resources">Resources</a>
          <a href="/video">Videos</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div>
          <strong>ACEgate ECE</strong>
          <p>Master ECE. Crack GATE. Build Your Future.</p>
        </div>

        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/legal">Legal</a>
        </div>
      </div>

      <div class="copyright">
        © {new Date().getFullYear()} ACEgate ECE. All rights reserved.
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector(".menu-toggle");
      const navigation = document.querySelector("#main-navigation");

      menuButton?.addEventListener("click", () => {
        const isOpen = navigation?.classList.toggle("is-open");

        menuButton.setAttribute(
          "aria-expanded",
          String(isOpen)
        );

        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Close navigation menu" : "Open navigation menu"
        );
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          navigation.classList.remove("is-open");
          menuButton?.setAttribute("aria-expanded", "false");
          menuButton?.setAttribute(
            "aria-label",
            "Open navigation menu"
          );
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #111827;
    background: #ffffff;
    line-height: 1.6;
  }

  /* =========================
     HEADER
     ========================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e5e7eb;
    backdrop-filter: blur(10px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    min-height: 72px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    color: #111827;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    justify-content: flex-end;
  }

  .main-nav a {
    color: #374151;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .main-nav a:hover {
    color: #4f46e5;
    transform: translateY(-1px);
  }

  /* =========================
     HAMBURGER BUTTON
     ========================= */

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 8px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #ffffff;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #111827;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .menu-toggle:hover {
    border-color: #c7d2fe;
    background: #f9fafb;
  }

  /* =========================
     MAIN
     ========================= */

  main {
    min-height: 60vh;
  }

  /* =========================
     FOOTER
     ========================= */

  .site-footer {
    margin-top: 80px;
    padding: 45px 24px 25px;
    background: #111827;
    color: #e5e7eb;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .site-footer strong {
    font-size: 1.2rem;
    color: #ffffff;
  }

  .site-footer p {
    margin: 8px 0 0;
    color: #9ca3af;
  }

  .footer-links {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .footer-links a {
    color: #d1d5db;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .copyright {
    max-width: 1200px;
    margin: 35px auto 0;
    padding-top: 20px;
    border-top: 1px solid #374151;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  /* =========================
     TABLET
     ========================= */

  @media (max-width: 900px) {
    .header-container {
      padding: 16px 20px;
    }

    .menu-toggle {
      display: flex;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 18px 20px 22px;
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 12px 25px rgba(17, 24, 39, 0.08);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .main-nav.is-open {
      display: flex;
    }

    .main-nav a {
      display: block;
      padding: 13px 8px;
      font-size: 1rem;
      border-radius: 8px;
    }

    .main-nav a:hover {
      background: #f5f7ff;
      transform: none;
    }

    .footer-container {
      flex-direction: column;
    }

    .footer-links {
      flex-wrap: wrap;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 600px) {
    .header-container {
      min-height: 64px;
      padding: 12px 16px;
    }

    .logo {
      font-size: 1.15rem;
    }

    .site-footer {
      padding-left: 20px;
      padding-right: 20px;
    }

    .footer-container {
      gap: 25px;
    }
  }
</style>